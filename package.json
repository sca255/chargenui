{
  "name": "chargenui",
  "version": "1.2.0",
  "description": "Uncensored Roleplay Character Generator, Enhancer & Vision Harness",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "build:html": "bun run scripts/build_html.ts",
    "build:js": "bun build src/public/js/main.js --outfile src/public/dist/bundle.js",
    "build": "bun run build:html && bun run build:js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6"
  }
}
