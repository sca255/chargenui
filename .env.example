# CharGen Harness Environment Configuration
# Optional: Pre-configure API keys here so you don't need to enter them in the UI

# Port to run the server on (default: 3333)
PORT=3333

# Google Gemini API Key (Multimodal Vision + Text, completely uncensored with BLOCK_NONE)
GEMINI_API_KEY=

# OpenRouter API Key (For uncensored open models like DeepSeek, Llama 3 Uncensored, etc.)
OPENROUTER_API_KEY=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# OpenAI or Local compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local llama.cpp server (llama-server with OpenAI-compatible endpoint)
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# Maximum time to wait for a local model response (minutes)
LLAMACPP_TIMEOUT_MINUTES=30
